# ThreatLens AI v0.14.0 - direct local-development defaults.
# For the Batch 7 Docker runtime, run scripts/bootstrap_batch7_env.ps1 instead.
# Do not copy this file over the generated .env.batch7.local secret file.
THREATLENS_DATABASE_URL=sqlite:///database/threatlens.db
THREATLENS_DB_POOL_SIZE=5
THREATLENS_DB_MAX_OVERFLOW=5
THREATLENS_DB_POOL_RECYCLE_SECONDS=900
THREATLENS_DB_POOL_TIMEOUT_SECONDS=30

# Generate a cryptographically random value. Never commit the real secret.
THREATLENS_JWT_SECRET=
THREATLENS_JWT_ISSUER=threatlens-ai
THREATLENS_JWT_AUDIENCE=threatlens-api
THREATLENS_ACCESS_TOKEN_MINUTES=15
THREATLENS_REFRESH_TOKEN_HOURS=8
THREATLENS_MAX_FAILED_LOGINS=5
THREATLENS_LOCKOUT_MINUTES=15
THREATLENS_API_URL=http://127.0.0.1:8000
THREATLENS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
THREATLENS_TRUSTED_HOSTS=localhost,127.0.0.1,testserver
THREATLENS_ENABLE_DEVELOPMENT_DOCS=0
THREATLENS_MAX_UPLOAD_BYTES=10485760
THREATLENS_MAX_UPLOAD_FILES=10

# Ollama. For an authenticated HTTPS remote endpoint set the URL and API key.
THREATLENS_RAG_ENABLED=1
THREATLENS_OLLAMA_URL=http://127.0.0.1:11434
THREATLENS_OLLAMA_API_KEY=
THREATLENS_RAG_STANDARD_LLM_MODEL=qwen3.5:4b
THREATLENS_RAG_LLM_MODEL=qwen3.5:4b
THREATLENS_RAG_DEEP_LLM_MODEL=qwen3.5:9b
THREATLENS_RAG_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Local: sqlite. Production: pgvector.
THREATLENS_RAG_VECTOR_BACKEND=sqlite
THREATLENS_RAG_PGVECTOR_DATABASE_URL=
THREATLENS_RAG_EMBEDDING_DIMENSIONS=1024
THREATLENS_RAG_PGVECTOR_HNSW=1
THREATLENS_RAG_EMBEDDING_BACKEND=ollama
THREATLENS_RAG_VECTOR_PATH=data/rag/vector_store.sqlite3
THREATLENS_RAG_COLLECTION=threatlens-v0120-knowledge
THREATLENS_RAG_TOP_K=3
THREATLENS_RAG_EMBED_BATCH_SIZE=4
THREATLENS_RAG_MIN_RELEVANCE=0.18
THREATLENS_RAG_MAX_INCIDENT_CONTEXT_CHARS=6500
THREATLENS_RAG_MAX_KNOWLEDGE_CONTEXT_CHARS=6000
THREATLENS_RAG_MAX_QUESTION_CHARS=2000
THREATLENS_RAG_CONNECT_TIMEOUT_SECONDS=3
THREATLENS_RAG_READ_TIMEOUT_SECONDS=120
THREATLENS_RAG_OLLAMA_NUM_CTX=8192
THREATLENS_RAG_OLLAMA_NUM_PREDICT=900
THREATLENS_RAG_DEEP_READ_TIMEOUT_SECONDS=600
THREATLENS_RAG_DEEP_OLLAMA_NUM_CTX=16384
THREATLENS_RAG_DEEP_OLLAMA_NUM_PREDICT=1600
THREATLENS_RAG_AUTO_DEEP_THRESHOLD=5
THREATLENS_RAG_FALLBACK_TO_STANDARD=1
THREATLENS_RAG_STANDARD_FALLBACK_MAX_PRIMARY_SECONDS=30
THREATLENS_RAG_EXACT_KNOWLEDGE_LIMIT=8
THREATLENS_RAG_API_TIMEOUT_SECONDS=1320
THREATLENS_RAG_INCLUDE_ANALYST_NOTES=1
# Durable AI jobs are disabled for direct local development and enabled by Batch 7 Compose.
THREATLENS_ASYNC_JOBS_ENABLED=0
THREATLENS_REDIS_URL=redis://127.0.0.1:6379/0
THREATLENS_AI_QUEUE_NAME=threatlens:ai:jobs
THREATLENS_AI_WORKER_BLOCK_SECONDS=5
THREATLENS_AI_JOB_LEASE_SECONDS=1800
THREATLENS_AI_JOB_HEARTBEAT_SECONDS=30
THREATLENS_AI_JOB_RECOVERY_INTERVAL_SECONDS=60
THREATLENS_AI_JOB_MAX_ATTEMPTS=2
THREATLENS_AI_JOB_RETRY_DELAY_SECONDS=5
THREATLENS_AI_WORKER_PRESENCE_TTL_SECONDS=90
# Durable AI queue backpressure
THREATLENS_AI_MAX_ACTIVE_JOBS=100
THREATLENS_AI_MAX_ACTIVE_JOBS_PER_ACTOR=5
