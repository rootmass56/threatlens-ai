# Copy to .env.batch6.local by running scripts/bootstrap_batch6_env.ps1.
# Never commit real secrets.
THREATLENS_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM
THREATLENS_REDIS_PASSWORD=REPLACE_WITH_RANDOM
THREATLENS_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
THREATLENS_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
THREATLENS_OLLAMA_URL=http://host.docker.internal:11434
THREATLENS_OLLAMA_API_KEY=
# Optional: set after creating a syslog_rfc ingestion source from the UI/API.
THREATLENS_SYSLOG_INGEST_KEY=
